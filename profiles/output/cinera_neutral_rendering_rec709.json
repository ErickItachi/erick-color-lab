    "limit": [
      1.147,
      1.264,
      1.312
    ],
    "power": 1.2
  },
  "display_gamut_compression": {
    "method": "same algorithm, AP1 -> Rec.709",
    "threshold": [
      0.85,
      0.85,
      0.85
